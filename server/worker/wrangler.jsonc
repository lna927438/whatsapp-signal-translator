{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "realtime-translator-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-10",
  "vars": {
    "OPENAI_MODEL": "gpt-5.6-luna"
  },
  "secrets": {
    "required": [
      "SUPABASE_URL",
      "SUPABASE_PUBLISHABLE_KEY",
      "SUPABASE_SECRET_KEY",
      "OPENAI_API_KEY"
    ]
  }
}
