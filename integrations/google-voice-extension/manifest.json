{
  "manifest_version": 3,
  "name": "HelloDog · Google Voice 翻译助手",
  "version": "0.2.0",
  "description": "翻译已识别会话的可见纯文本短信，发送前预览确认；保留待核对记录，不自动重发。",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "storage",
    "contextMenus"
  ],
  "host_permissions": [
    "https://voice.google.com/*"
  ],
  "background": {
    "service_worker": "background.mjs",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "HelloDog · Google Voice"
  },
  "content_scripts": [
    {
      "matches": [
        "https://voice.google.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": false,
      "world": "ISOLATED"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  }
}
