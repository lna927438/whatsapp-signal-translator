diff --git a/dist/v35.js b/dist/v35.js
index 3fe6573cba6014ded6c4b7ce3636efeb286e11e1..3db359001aa330d448b42852f2c452ad77847212 100644
--- a/dist/v35.js
+++ b/dist/v35.js
@@ -27,6 +27,10 @@ export default function v35(version, hash, value, namespace, buf, offset) {
     bytes[8] = (bytes[8] & 0x3f) | 0x80;
     if (buf) {
         offset = offset || 0;
+        // Security backport: uuidjs/uuid@9d27ddf7046ce496ef39569ff84d948eeff9cb2a
+        if (offset < 0 || offset + 16 > buf.length) {
+            throw new RangeError(`UUID byte range ${offset}:${offset + 15} is out of buffer bounds`);
+        }
         for (let i = 0; i < 16; ++i) {
             buf[offset + i] = bytes[i];
         }
