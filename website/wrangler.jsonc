{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "realtime-translator-web",
  "main": "worker.mjs",
  "compatibility_date": "2026-09-10",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none"
  }
}
