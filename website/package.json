{
  "name": "realtime-translator-website",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.5.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build && node scripts/prerender.mjs",
    "preview": "vite preview",
    "build:admin-local": "vue-tsc --noEmit && vite build --mode admin-local --outDir dist-admin-local",
    "deploy": "node ../scripts/release-gate.mjs --web && wrangler deploy"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.116.0",
    "vue": "3.5.42",
    "vue-router": "5.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "6.0.8",
    "typescript": "5.9.2",
    "vite": "8.2.2",
    "vue-tsc": "3.3.11",
    "wrangler": "4.130.0"
  }
}
