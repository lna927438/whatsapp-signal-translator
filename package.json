{
  "name": "whatsapp-signal-translator",
  "version": "0.5.14",
  "private": true,
  "packageManager": "pnpm@11.5.2",
  "author": "lna927438",
  "description": "HelloDog — a friendly workspace for cross-language chats",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "vue-tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "dist:win": "npm run build && node --require ./scripts/windows-build-paths.cjs ./node_modules/electron-builder/cli.js --win nsis --publish never",
    "security:scan": "node scripts/security-scan.mjs",
    "security:release-check": "node scripts/release-gate.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.116.0",
    "qrcode": "1.5.4",
    "vue": "3.5.42"
  },
  "devDependencies": {
    "@types/node": "22.20.2",
    "@types/qrcode": "1.5.6",
    "@vitejs/plugin-vue": "6.0.8",
    "electron": "44.3.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "typescript": "5.9.2",
    "vite": "7.3.6",
    "vue-tsc": "3.3.11"
  },
  "build": {
    "compression": "maximum",
    "forceCodeSigning": false,
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true
    },
    "appId": "com.local.whatsappsignaltranslator",
    "productName": "HelloDog",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json",
      "resources/security/**/*",
      "resources/brand/**/*"
    ],
    "extraResources": [
      {
        "from": "integrations/signal-desktop/release/hellodog-security-core/win-unpacked",
        "to": "signal-desktop",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "resources/native",
        "to": "native",
        "filter": [
          "SignalWindowHost.exe"
        ]
      },
      {
        "from": "integrations/notices",
        "to": "signal-source-notices",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "resources/signal",
        "to": "signal",
        "filter": [
          "**/*"
        ]
      },
      {
        "to": "voice",
        "filter": [
          "**/*"
        ],
        "from": "resources/voice/bin"
      },
      {
        "to": "voice-notices",
        "filter": [
          "LICENSE-*.txt"
        ],
        "from": "resources/voice"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "resources/brand/hellodog-icon.png"
    },
    "nsis": {
      "differentialPackage": false,
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
