# Public Supabase configuration for the desktop/web client.
# Safe to ship only with correct Row Level Security policies.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# Legacy local translation provider overrides used during migration.
# These will be removed from the desktop client once translation is fully server-side.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
DEEPL_API_KEY=
GOOGLE_TRANSLATE_API_KEY=
SIGNAL_CLI_PATH=

# NEVER put sb_secret_..., service_role, database passwords, Stripe secret keys,
# or OpenAI server keys into any VITE_* variable or desktop bundle.
